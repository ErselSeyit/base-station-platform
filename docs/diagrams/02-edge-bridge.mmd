flowchart TB
    DEV[Physical Devices<br/>MIPS / ARM]

    subgraph CLIB["C Protocol Library"]
        C1[Binary Serialization]
        C2[HMAC-SHA256]
        C3[Auto-Reconnect]
    end

    subgraph TRANSPORT["Transport Layer"]
        T1[Serial / UART]
        T2[TCP Socket]
        T3[TLS / mTLS]
    end

    subgraph PROTOCOLS["Protocol Adapters"]
        P1[SNMP]
        P2[MQTT]
        P3[Modbus]
        P4[NETCONF]
        P5[O-RAN]
    end

    CLOUD[Cloud Platform<br/>Monitoring Service]

    DEV --> CLIB
    CLIB --> T1
    T1 --> T2
    T2 --> T3
    T3 --> P1
    T3 --> P2
    T3 --> P3
    T3 --> P4
    T3 --> P5
    P1 & P2 & P3 & P4 & P5 --> CLOUD

